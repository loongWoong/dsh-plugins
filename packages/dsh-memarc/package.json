{
  "name": "dsh-memarc",
  "version": "0.1.1",
  "description": "DSH plugin: per-workspace long-term memory store (.dsh-memory/memory.json) plus session archive management (archive / list / full-text search over archived sessions). Ships 7 model tools and a Settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loongWoong/dsh-plugins.git",
    "directory": "packages/dsh-memarc"
  },
  "bugs": {
    "url": "https://github.com/loongWoong/dsh-plugins/issues"
  },
  "homepage": "https://github.com/loongWoong/dsh-plugins/tree/main/packages/dsh-memarc#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "session-archive",
    "settings"
  ]
}

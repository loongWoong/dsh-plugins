{
  "name": "dsh-model-reasoning",
  "version": "0.1.0",
  "description": "DSH plugin: Model Reasoning — a settings page to edit each model's reasoning capability the way pi-web's model editor does: reasoning-effort levels and their wire values, default reasoning effort, image input, context window, max output tokens, and per-protocol compat switches. Writes straight into the llm-pi-ai settings namespace and takes effect on the next request, no restart.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loongWoong/dsh-plugins.git",
    "directory": "packages/dsh-model-reasoning"
  },
  "bugs": {
    "url": "https://github.com/loongWoong/dsh-plugins/issues"
  },
  "homepage": "https://github.com/loongWoong/dsh-plugins/tree/main/packages/dsh-model-reasoning#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model",
    "reasoning",
    "thinking",
    "settings",
    "llm"
  ]
}

{
  "name": "dsh-session-branches",
  "version": "0.1.0",
  "description": "DSH plugin: Session Branches — visualize session fork relationships (parentSession / subagent lineage) as a tree per workspace. Floating sidebar panel (shell.overlay) plus a Settings page; click any session to open it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loongWoong/dsh-plugins.git",
    "directory": "packages/dsh-session-branches"
  },
  "bugs": {
    "url": "https://github.com/loongWoong/dsh-plugins/issues"
  },
  "homepage": "https://github.com/loongWoong/dsh-plugins/tree/main/packages/dsh-session-branches#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "tree",
    "sidebar"
  ]
}
